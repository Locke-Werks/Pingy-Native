#include <winver.h>

// First icon in the file: Explorer uses it, and Qt picks IDI_ICON1 for windows.
IDI_ICON1 ICON "@ICON@"

1 24 "@MANIFEST@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @COMMA@
PRODUCTVERSION  @COMMA@
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Locke Werks"
            VALUE "FileDescription",  "Pingy"
            VALUE "FileVersion",      "@VER@"
            VALUE "InternalName",     "pingy"
            VALUE "OriginalFilename", "pingy.exe"
            VALUE "ProductName",      "Pingy"
            VALUE "ProductVersion",   "@VER@"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Locke Werks. MIT License."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
